[Unit]
Description=TV + vacuum remote
After=network-online.target
Wants=network-online.target

[Service]
# Edit User and the two paths, then:
#   sudo cp tv-vacuum-remote.service /etc/systemd/system/ && sudo systemctl enable --now tv-vacuum-remote
User=pi
WorkingDirectory=/home/pi/tv-vacuum-remote
ExecStart=/home/pi/tv-vacuum-remote/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8080 --timeout-graceful-shutdown 3
Restart=always
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
